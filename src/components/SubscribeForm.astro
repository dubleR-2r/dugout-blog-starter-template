---
import {
	SIGNUP_ENDPOINT,
	CHECKOUT_READY,
	PREVIEW_NOTICE,
	FREE_DAYS,
	FREE_LABEL,
	PRICE_AMOUNT,
	PRICE_INTERVAL,
} from '../consts';

interface Props {
	/** Label on the submit button. */
	cta?: string;
	/** Show the fine print under the form. */
	note?: boolean;
	/** Where on the site the form sits, recorded with the signup. */
	source?: string;
}
const { cta = FREE_LABEL, note = true, source = 'site' } = Astro.props;

// A stable id so the label/input pair stays unique across form instances.
const fieldId = `email-${cta.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---

<!--
	Free signup: email only, no card. Posts to the Make webhook "Dugout Signup
	(free 2 weeks)", which stores the address and sends the welcome email.
	With JavaScript the post is sent in the background and the visitor goes to
	/welcome; without it the browser posts the form and Make redirects there.
-->
<form
	class="subscribe"
	method="post"
	action={CHECKOUT_READY ? SIGNUP_ENDPOINT : undefined}
	data-ready={String(CHECKOUT_READY)}
	novalidate
>
	<label class="sr-only" for={fieldId}>Email address</label>
	<input
		id={fieldId}
		type="email"
		name="email"
		placeholder="you@company.com"
		autocomplete="email"
		required
		disabled={!CHECKOUT_READY}
	/>
	<!-- Honeypot: hidden from people, filled in by bots; signups with it set are ignored. -->
	<div class="hp" aria-hidden="true">
		<label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
	</div>
	<input type="hidden" name="source" value={source} />
	<button class="btn" type="submit" disabled={!CHECKOUT_READY}>{cta}</button>
	<p class="error" role="alert" hidden></p>
	{
		CHECKOUT_READY
			? note && (
					<p class="fine">
						Free for {FREE_DAYS} days with just your email, no card. If you want to keep going after
						that, it's {PRICE_AMOUNT} {PRICE_INTERVAL}; we'll remind you two days before. Unsubscribe
						anytime. By signing up you agree to the <a href="/terms">Terms</a> and{' '}
						<a href="/privacy">Privacy Policy</a>.
					</p>
				)
			: <p class="preview">{PREVIEW_NOTICE}</p>
	}
</form>

<style>
	.subscribe {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.6rem;
		max-width: 480px;
	}
	.hp {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.error,
	.fine,
	.preview {
		grid-column: 1 / -1;
		margin: 0.25rem 0 0;
		font-size: 0.8rem;
		line-height: 1.5;
	}
	.error {
		color: #f87171;
	}
	.fine {
		color: var(--text-dim);
	}
	.preview {
		color: var(--text-muted);
	}
	input:disabled,
	button:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	@media (max-width: 480px) {
		.subscribe {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	document.querySelectorAll<HTMLFormElement>('form.subscribe').forEach((form) => {
		if (form.dataset.ready !== 'true') return;

		const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
		const error = form.querySelector<HTMLParagraphElement>('.error')!;
		const button = form.querySelector<HTMLButtonElement>('button')!;
		const label = button.textContent;

		const clearError = () => {
			error.hidden = true;
			error.textContent = '';
		};
		input.addEventListener('input', clearError);

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const email = input.value.trim();

			if (!EMAIL_RE.test(email)) {
				error.textContent = 'Enter a valid email address.';
				error.hidden = false;
				input.focus();
				return;
			}

			clearError();
			button.disabled = true;
			button.textContent = 'Signing you up…';

			const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
			body.set('email', email);
			try {
				// The webhook does not send CORS headers, so the response is opaque;
				// reaching the server is enough.
				await fetch(form.action, { method: 'POST', mode: 'no-cors', body });
				window.location.href = '/welcome';
			} catch {
				error.textContent = 'Something went wrong. Please try again, or email us.';
				error.hidden = false;
				button.disabled = false;
				button.textContent = label;
			}
		});
	});
</script>
