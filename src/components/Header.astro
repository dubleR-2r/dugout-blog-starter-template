---
import Logo from './Logo.astro';
import { COMING_SOON, COMING_SOON_NOTICE } from '../consts';

interface Props {
	/** The landing page uses in-page anchors; other pages link back home. */
	home?: boolean;
}
const { home = false } = Astro.props;

// While in coming-soon mode the CTA still scrolls to the signup section, but it
// shouldn't promise a checkout that can't happen.
const ctaLabel = COMING_SOON ? 'Coming soon' : 'Start free trial';
---

<header>
	{
		COMING_SOON && (
			<div class="notice">
				<div class="wrap">{COMING_SOON_NOTICE}</div>
			</div>
		)
	}
	<div class="wrap bar">
		<a class="brand" href="/">
			<Logo class="brand-mark" size={26} />
			<span class="brand-name">Weekend Dugout</span>
		</a>
		<nav>
			{
				home ? (
					<>
						<a href="#how">How it works</a>
						<a href="#coverage">Coverage</a>
						<a href="/sample">Sample</a>
						<a href="#pricing">Pricing</a>
						<a class="cta" href="#subscribe">
							{ctaLabel}
						</a>
					</>
				) : (
					<a class="cta" href="/#subscribe">
						{ctaLabel}
					</a>
				)
			}
		</nav>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--border);
		background: rgba(10, 13, 20, 0.85);
		backdrop-filter: blur(12px);
	}
	.notice {
		border-bottom: 1px solid var(--border);
		background: rgba(52, 211, 153, 0.08);
		color: var(--text);
		font-size: 0.85rem;
		line-height: 1.5;
		text-align: center;
		padding: 0.6rem 0;
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
		color: var(--text);
	}
	.brand:hover {
		text-decoration: none;
		color: #fff;
	}
	.brand-mark {
		flex: none;
		filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.35));
	}
	.brand-name {
		line-height: 1;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		font-size: 0.9rem;
	}
	nav a {
		color: var(--text-muted);
	}
	nav a:hover {
		color: var(--text);
		text-decoration: none;
	}
	.cta {
		padding: 0.5rem 1.1rem;
		border-radius: 8px;
		font-weight: 700;
		color: var(--gold-ink);
		background: var(--gold);
		box-shadow: 0 4px 14px -6px rgba(251, 191, 36, 0.6);
		transition:
			background 0.15s ease,
			box-shadow 0.15s ease;
	}
	.cta:hover {
		color: var(--gold-ink);
		background: var(--gold-bright);
		text-decoration: none;
		box-shadow: 0 6px 18px -6px rgba(251, 191, 36, 0.75);
	}
	@media (max-width: 620px) {
		nav a:not(.cta) {
			display: none;
		}
	}
</style>
