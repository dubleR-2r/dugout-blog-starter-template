---
import { SITE_TITLE } from '../consts';

interface Props {
	/** The landing page uses in-page anchors; other pages link back home. */
	home?: boolean;
}
const { home = false } = Astro.props;
---

<header>
	<div class="wrap bar">
		<a class="brand" href="/">
			<span class="mark" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<nav>
			{
				home ? (
					<>
						<a href="#how">How it works</a>
						<a href="/sample">Sample</a>
						<a href="#pricing">Pricing</a>
						<a class="cta" href="#subscribe">
							Subscribe
						</a>
					</>
				) : (
					<a class="cta" href="/#subscribe">
						Subscribe
					</a>
				)
			}
		</nav>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--border);
		background: rgba(10, 13, 20, 0.85);
		backdrop-filter: blur(12px);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.01em;
		color: var(--text);
	}
	.brand:hover {
		text-decoration: none;
		color: #fff;
	}
	.mark {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--signal);
		box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.15);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		font-size: 0.9rem;
	}
	nav a {
		color: var(--text-muted);
	}
	nav a:hover {
		color: var(--text);
		text-decoration: none;
	}
	.cta {
		padding: 0.5rem 1.1rem;
		border: 1px solid var(--border-bright);
		border-radius: 8px;
		color: var(--text);
	}
	.cta:hover {
		border-color: var(--accent);
		color: var(--accent-bright);
	}
	@media (max-width: 620px) {
		nav a:not(.cta) {
			display: none;
		}
	}
</style>
