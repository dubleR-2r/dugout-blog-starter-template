---
import { SITE_TITLE, LEGAL_ENTITY, CONTACT_EMAIL, STRIPE_PORTAL_LINK } from '../consts';
const today = new Date();
---

<footer>
	<div class="wrap">
		<div class="disclaimer">
			<strong>{SITE_TITLE}</strong> is an informational service of {LEGAL_ENTITY}, trading as {
				SITE_TITLE
			}. Content summarizes publicly available filings and news for educational purposes only and is
			not investment, legal, or tax advice or a recommendation regarding any security. Accuracy and
			timeliness are not guaranteed; original sources control. Consult a licensed professional before
			making investment decisions.
		</div>
		<div class="bar">
			<span>&copy; {today.getFullYear()} {LEGAL_ENTITY}</span>
			<nav>
				{
					STRIPE_PORTAL_LINK && (
						<a href={STRIPE_PORTAL_LINK} target="_blank" rel="noopener">
							Manage subscription
						</a>
					)
				}
				<a href="/terms">Terms of Service</a>
				<a href="/privacy">Privacy</a>
				<a href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background: var(--bg-elevated);
		padding: 3rem 0 4rem;
	}
	.disclaimer {
		font-size: 0.8rem;
		line-height: 1.6;
		color: var(--text-dim);
		max-width: 78ch;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}
	.disclaimer strong {
		color: var(--text-muted);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: space-between;
		align-items: center;
		padding-top: 1.5rem;
		font-size: 0.85rem;
		color: var(--text-dim);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}
	nav a {
		color: var(--text-muted);
	}
</style>
