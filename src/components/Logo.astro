---
// The Weekend Dugout mark: ascending candlestick bars (the chart) beside a green
// candle swung as a baseball bat with a gold ball off the barrel. Extracted from
// the brand banner (weekend_dugout_banner.svg): gradient bars, a shine highlight
// on the bat, a radial-gradient ball, and a knob. Pure vector — no font needed.
// Wider than tall; width scales from the given height.
interface Props {
	size?: number;
	class?: string;
}
const { size = 26, class: cls = '' } = Astro.props;
const w = Math.round((size * 244) / 210);
---

<svg
	class={cls}
	width={w}
	height={size}
	viewBox="422.5 130 244 210"
	fill="none"
	role="img"
	aria-label="Weekend Dugout"
	xmlns="http://www.w3.org/2000/svg"
>
	<defs>
		<linearGradient id="wdBarA" x1="0" y1="1" x2="0" y2="0">
			<stop offset="0%" stop-color="#33507a" /><stop offset="100%" stop-color="#436698" />
		</linearGradient>
		<linearGradient id="wdBarB" x1="0" y1="1" x2="0" y2="0">
			<stop offset="0%" stop-color="#3f6fb0" /><stop offset="100%" stop-color="#5488cf" />
		</linearGradient>
		<linearGradient id="wdBarC" x1="0" y1="1" x2="0" y2="0">
			<stop offset="0%" stop-color="#4a83c6" /><stop offset="100%" stop-color="#63a0e0" />
		</linearGradient>
		<linearGradient id="wdBat" x1="0.15" y1="1" x2="0.9" y2="0.05">
			<stop offset="0%" stop-color="#22a074" /><stop offset="50%" stop-color="#33cc95" /><stop offset="100%" stop-color="#66ecb6" />
		</linearGradient>
		<linearGradient id="wdBatShine" x1="0" y1="1" x2="0.9" y2="0.1">
			<stop offset="0%" stop-color="#ffffff" stop-opacity="0" /><stop offset="72%" stop-color="#ffffff" stop-opacity="0" /><stop offset="100%" stop-color="#d6ffef" stop-opacity="0.5" />
		</linearGradient>
		<radialGradient id="wdBall" cx="36%" cy="30%" r="80%">
			<stop offset="0%" stop-color="#ffe19a" /><stop offset="55%" stop-color="#f7c34b" /><stop offset="100%" stop-color="#e6a12b" />
		</radialGradient>
	</defs>

	<g transform="translate(430,140) scale(0.87) translate(-150,-122)">
		<rect x="150" y="252" width="30" height="86" rx="9" fill="url(#wdBarA)" />
		<rect x="192" y="214" width="30" height="124" rx="9" fill="url(#wdBarB)" />
		<rect x="234" y="176" width="30" height="162" rx="9" fill="url(#wdBarC)" />
		<g transform="rotate(40 300 252)">
			<circle cx="300" cy="112" r="23" fill="url(#wdBall)" />
			<path
				d="M300 140 C 320 140 326 166 322 193 C 318 233 312 286 309 320 C 308 335 310 344 313 350 C 316 356 316 365 300 367 C 284 365 284 356 287 350 C 290 344 292 335 291 320 C 288 286 282 233 278 193 C 274 166 280 140 300 140 Z"
				fill="url(#wdBat)"
			/>
			<path
				d="M300 140 C 320 140 326 166 322 193 C 318 233 312 286 309 320 C 308 335 310 344 313 350 C 316 356 316 365 300 367 C 284 365 284 356 287 350 C 290 344 292 335 291 320 C 288 286 282 233 278 193 C 274 166 280 140 300 140 Z"
				fill="url(#wdBatShine)"
			/>
			<circle cx="300" cy="358" r="12" fill="#1f9770" />
		</g>
	</g>
</svg>
