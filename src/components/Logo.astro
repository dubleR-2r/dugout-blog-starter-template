---
// The Weekend Dugout mark: an ascending candlestick chart (the "signal building")
// beside a green candle swung as a baseball bat (barrel = candle body, wick down
// the axis, gold dot = the ball off the barrel). Chart bars are blue, the bat is
// green, the ball is gold — three clean reads: markets, the swing, the signal.
// Wider than tall; width scales from the given height. Keep the bat/ball geometry
// in sync with public/favicon.svg (which uses the simplified bat-only mark).
interface Props {
	size?: number;
	class?: string;
}
const { size = 26, class: cls = '' } = Astro.props;
const w = Math.round((size * 44) / 32);
---

<svg
	class={cls}
	width={w}
	height={size}
	viewBox="0 0 44 32"
	fill="none"
	role="img"
	aria-label="Weekend Dugout"
>
	<!-- ascending candle bars (the chart) -->
	<rect x="2.5" y="18.5" width="3.4" height="7.5" rx="1.7" fill="#2f5a86" />
	<rect x="8.4" y="13.5" width="3.4" height="12.5" rx="1.7" fill="#3d78c0" />
	<rect x="14.3" y="8.5" width="3.4" height="17.5" rx="1.7" fill="#4d9fff" />

	<!-- candle swung as a bat + gold ball -->
	<g transform="translate(13,0) rotate(34 16 16)">
		<line x1="16" y1="1" x2="16" y2="31.4" stroke="#34d399" stroke-width="1.5" stroke-linecap="round" />
		<path
			d="M16,4.4 C18.2,4.4 20,6.2 20,8.8 C20,12.6 18.5,15.6 17.6,19 C17.1,21.3 16.9,22.8 17,24 C17.1,25.4 18.1,25.9 18.1,26.9 C18.1,28.1 17.1,28.8 16,28.8 C14.9,28.8 13.9,28.1 13.9,26.9 C13.9,25.9 14.9,25.4 15,24 C15.1,22.8 14.9,21.3 14.4,19 C13.5,15.6 12,12.6 12,8.8 C12,6.2 13.8,4.4 16,4.4 Z"
			fill="#34d399"
		/>
	</g>
	<circle cx="38" cy="3.8" r="2.3" fill="#fbbf24" />
</svg>
