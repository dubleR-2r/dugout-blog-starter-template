---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import {
	SITE_TITLE,
	SITE_TAGLINE,
	SITE_DESCRIPTION,
	LEGAL_ENTITY,
	PLAN_NAME,
	PRICE_AMOUNT,
	PRICE_INTERVAL,
	LAUNCH_OFFER,
	COMING_SOON,
	TRIAL_DAYS,
	FILINGS_CADENCE,
	NEWS_CADENCE,
	FILINGS_DAYS_SHORT,
	NEWS_DAYS_SHORT,
	SEC_WATCHLIST,
	NEWS_THEMES,
	SITE_URL,
} from '../consts';

// Counts, derived so the copy can never drift from the lists themselves.
const secCount = SEC_WATCHLIST.reduce((n, group) => n + group.tickers.length, 0);
const themeCount = NEWS_THEMES.length;

// Honest proof points for the hero stat strip — specifics in place of the
// subscriber counts a new product can't yet claim.
const proofPoints = [
	{ stat: `${secCount} companies`, label: 'every SEC filing scanned and decoded' },
	{ stat: `${themeCount} themes`, label: 'news filtered by thesis, not by ticker' },
	{ stat: 'Set schedule', label: `filings ${FILINGS_DAYS_SHORT}, news ${NEWS_DAYS_SHORT}` },
	{ stat: 'Source-linked', label: 'every item links to the primary source' },
];

// One representative brief entry for the homepage teaser. ILLUSTRATIVE — written
// example of the format, not a real filing; labelled as such on the page. The
// full, longer sample lives at /sample.
const teaser = {
	form: '8-K',
	company: 'Example Semiconductor Corp.',
	ticker: 'EXMP',
	tags: 'Memory/HBM · Core · High · HBM pricing, Supply vs demand',
	body: 'The filing discloses a multi-year supply agreement for high-bandwidth memory [confirmed]; pricing terms not disclosed. Item 1.01 characterises the agreement as material to the registrant.',
	filed: '2026-07-21',
};

// Page-specific structured data: the subscription product and its offer.
const productSchema = [
	{
		'@type': 'Product',
		name: `${SITE_TITLE} — ${PLAN_NAME}`,
		description: SITE_DESCRIPTION,
		brand: { '@type': 'Brand', name: SITE_TITLE },
		offers: {
			'@type': 'Offer',
			price: PRICE_AMOUNT.replace(/[^0-9.]/g, ''),
			priceCurrency: 'USD',
			url: `${SITE_URL}/#subscribe`,
			availability: COMING_SOON
				? 'https://schema.org/PreOrder'
				: 'https://schema.org/InStock',
		},
	},
];

const steps = [
	{
		n: '1',
		title: 'Monitor',
		body: 'Automated watchers track EDGAR filings (8-Ks, 10-Qs, 13-Fs, and more) and vetted news feeds around the clock.',
	},
	{
		n: '2',
		title: 'Filter & decode',
		body: 'Filings are sorted by item type and materiality — a §1.01 material agreement isn’t a §5.02 board reshuffle — and summarized in one or two plain-English lines with a direct link to the source document.',
	},
	{
		n: '3',
		title: 'Deliver',
		body: `Clean, scannable briefs in your inbox — filing summaries ${FILINGS_CADENCE}, news briefs ${NEWS_CADENCE}. No terminal, no tab-hoarding, no doomscrolling. Read each in five minutes; go deeper only where it’s warranted.`,
	},
];

const planFeatures = [
	`SEC filing summaries ${FILINGS_CADENCE}`,
	`Curated news briefs ${NEWS_CADENCE}`,
	'Plain-English materiality notes with source links',
	'Cancel anytime',
];

const faqs = [
	{
		q: 'Is The Weekend Dugout stock picks or trade alerts?',
		a: 'No — and deliberately so. The Weekend Dugout tells you what happened and why it’s material. What you do with it is your decision. We report facts and context, never buy/sell calls.',
	},
	{
		q: 'Is there a free trial?',
		a: `Yes — every subscription starts with a ${TRIAL_DAYS}-day free trial. You add a card up front so the digest can begin immediately, but you aren’t charged until the trial ends. Cancel anytime before then and you pay nothing.`,
	},
	{
		q: 'Isn’t EDGAR free?',
		a: 'Completely — and you’re welcome to read a few thousand filings a day yourself. You’re not paying for the data; you’re paying for the filtering, the plain-English decoding, and the five-minute format.',
	},
	{
		q: 'What companies do you cover?',
		a: `Two different ways. On the SEC side we scan every filing from a fixed watchlist of ${secCount} companies — foundry and packaging (TSM, AMKR), design IP (ARM), memory, compute, EDA and equipment, plus the hyperscalers (META, MSFT) and a couple of portfolio holdings (PLTR, HOOD). The news brief isn’t ticker-locked: it’s filtered by thesis theme — power constraint, capex concentration, HBM pricing and more — so any company moving one of those stories can appear, watchlist or not. Full breakdown in “What we watch” above.`,
	},
	{
		q: 'How is this different from a free filing alert?',
		a: 'Alerts forward you raw filings and leave the reading to you. We do the opposite: filter thousands of filings down to the material handful, decode each in plain English, tag it against the thesis (layer, materiality, theme), and link the source — so you know what happened and why it matters, not just that something was filed.',
	},
	{
		q: 'How often does it arrive?',
		a: `SEC filing summaries go out ${FILINGS_CADENCE}, and news briefs ${NEWS_CADENCE}. The monitoring runs around the clock, but delivery is on that schedule — we never guarantee timeliness, and original sources always control.`,
	},
	{
		q: 'Can I cancel?',
		a: 'Anytime, one click, effective at the end of your billing period. No calls, no guilt trips.',
	},
	{
		q: 'Do you provide investment advice?',
		a: 'No. This is an informational service. See the full disclaimer below and our Terms of Service.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — ${SITE_TAGLINE}`}
			description={SITE_DESCRIPTION}
			schema={productSchema}
		/>
	</head>
	<body>
		<Header home />

		<main>
			<!-- Hero -->
			<section class="hero">
				<div class="wrap">
					<p class="eyebrow">{SITE_TAGLINE}</p>
					<h1>The material SEC filings behind the AI trade — filtered from the noise, decoded in plain English.</h1>
					<p class="lede">
						Every 8-K, every material disclosure, every headline that matters — filtered for what
						moves the AI trade, summarized in plain English, and delivered to your inbox. Built by a
						trader who got tired of finding out last.
					</p>
					<div class="hero-form">
						<SubscribeForm cta={`Start your ${TRIAL_DAYS}-day free trial`} />
					</div>
					<p class="secondary-cta">
						<a href="#sample">See what a brief looks like →</a>
					</p>
					<ul class="proof" aria-label="What you get">
						{
							proofPoints.map((point) => (
								<li>
									<span class="proof-stat">{point.stat}</span>
									<span class="proof-label">{point.label}</span>
								</li>
							))
						}
					</ul>
					{
						LAUNCH_OFFER && (
							<p class="offer">
								<strong>{LAUNCH_OFFER.text}</strong> — {LAUNCH_OFFER.deadline}.
							</p>
						)
					}
				</div>
			</section>

			<!-- The problem -->
			<section id="problem" class="band">
				<div class="wrap narrow">
					<p class="eyebrow">The problem</p>
					<h2>The information is public. The edge is in the filtering.</h2>
					<p>
						Every trading day, thousands of filings hit SEC EDGAR. A handful are material: the
						surprise CEO exit, the amended credit agreement, the 8-K quietly disclosing a lost
						customer. The rest is noise. Institutions pay teams to read them the moment they land.
						Retail traders find out when it&rsquo;s already in the price.
					</p>
					<p>
						{SITE_TITLE} closes that gap with automation: continuous EDGAR monitoring, materiality filtering,
						and a plain-English digest that tells you what was filed, why it matters, and where to read
						the original — plus a curated stream of market news headlines so the context arrives with
						the catalyst.
					</p>
				</div>
			</section>

			<!-- How it works -->
			<section id="how" class="band alt">
				<div class="wrap">
					<p class="eyebrow">How it works</p>
					<h2>Three moving parts.</h2>
					<div class="cards">
						{
							steps.map((step) => (
								<article class="card">
									<p class="tag">{step.n}</p>
									<h3>{step.title}</h3>
									<p>{step.body}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- Coverage -->
			<section id="coverage" class="band">
				<div class="wrap">
					<p class="eyebrow">What we watch</p>
					<h2>One thesis, two feeds.</h2>
					<p class="lede">
						The SEC filings we scan come from a fixed watchlist. The news we surface is filtered by
						theme — so the companies in it shift with the story, but the questions never do.
					</p>

					<div class="watch-block">
						<p class="watch-head">
							SEC filings <span>Every filing from {secCount} companies</span>
						</p>
						<div class="coverage-grid">
							{
								SEC_WATCHLIST.map((group) => (
									<article class="coverage-cell">
										<p class="coverage-layer">{group.role}</p>
										<ul class="coverage-tickers">
											{group.tickers.map((t) => (
												<li>{t}</li>
											))}
										</ul>
									</article>
								))
							}
						</div>
					</div>

					<div class="watch-block">
						<p class="watch-head">
							News briefs <span>Filtered by {themeCount} thesis themes, not by ticker</span>
						</p>
						<ul class="themes">
							{
								NEWS_THEMES.map((theme) => (
									<li>
										<span class="theme-name">{theme.name}</span>
										<span class="theme-blurb">{theme.blurb}</span>
									</li>
								))
							}
						</ul>
						<p class="coverage-note">
							Any company that moves a theme can appear — a utility, a hyperscaler, a pipeline
							operator — not just the watchlist. That&rsquo;s the point: the thesis is the filter,
							not the ticker.
						</p>
					</div>
				</div>
			</section>

			<!-- Sample teaser -->
			<section id="sample" class="band alt">
				<div class="wrap narrow">
					<p class="eyebrow">What lands in your inbox</p>
					<h2>A filing, decoded in two lines.</h2>
					<p class="lede">
						What was filed, the tags that place it in the thesis, one or two plain-English lines, and
						a link to the source. Read it in five minutes; go deeper only where it&rsquo;s warranted.
					</p>
					<div class="teaser-card">
						<p class="teaser-flag">Illustrative example — a written demonstration of the format, not a real filing.</p>
						<article class="teaser-entry">
							<p class="teaser-head">
								<strong>{teaser.form}</strong> — {teaser.company} ({teaser.ticker})
							</p>
							<p class="teaser-tags">{teaser.tags}</p>
							<p class="teaser-body">{teaser.body}</p>
							<p class="teaser-foot">Filed: {teaser.filed} · <span>View filing</span></p>
						</article>
					</div>
					<p class="secondary-cta">
						<a href="/sample">See a full sample issue →</a>
					</p>
				</div>
			</section>

			<!-- Pricing -->
			<section id="pricing" class="band">
				<div class="wrap">
					<div id="subscribe" class="pricing">
						<div>
							<p class="eyebrow">Pricing</p>
							<h2>One plan. Cancel anytime.</h2>
							<p class="lede">
								{
									COMING_SOON
										? 'Sign-ups open in a few days. Pricing below is what it will be at launch.'
										: `Start a ${TRIAL_DAYS}-day free trial. Enter your email, add a card on Stripe, and the digest starts on the next delivery — you’re not charged until the trial ends, and you can cancel anytime.`
								}
							</p>
							<SubscribeForm cta="Start free trial" />
						</div>
						<aside class="price-card">
							<p class="plan">{PLAN_NAME}</p>
							<p class="trial-badge">{TRIAL_DAYS} days free</p>
							<p class="amount">then {PRICE_AMOUNT}<span>{PRICE_INTERVAL}</span></p>
							<ul>
								{planFeatures.map((feature) => <li>{feature}</li>)}
							</ul>
							{
								LAUNCH_OFFER && (
									<p class="offer-note">
										{LAUNCH_OFFER.text} — {LAUNCH_OFFER.deadline}. Apply the code at checkout.
									</p>
								)
							}
							<p class="secured">Payments handled securely by Stripe.</p>
						</aside>
					</div>
				</div>
			</section>

			<!-- Credibility -->
			<section id="about" class="band alt">
				<div class="wrap narrow">
					<p class="eyebrow">Who builds this</p>
					<h2>Built by a practitioner, not a content farm.</h2>
					<p>
						{SITE_TITLE} is a product of {LEGAL_ENTITY}, built by a software engineer and active trader
						who wanted one thing: the material facts, fast, without the noise. The same automation that
						powers his own process now powers yours.
					</p>
				</div>
			</section>

			<!-- FAQ -->
			<section id="faq" class="band">
				<div class="wrap narrow">
					<p class="eyebrow">FAQ</p>
					<h2>Questions.</h2>
					<div class="faq">
						{
							faqs.map((item) => (
								<details>
									<summary>{item.q}</summary>
									<p>{item.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* Hero */
	.hero {
		position: relative;
		padding: 6rem 0 5rem;
		overflow: hidden;
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(60ch 40ch at 15% -10%, rgba(77, 159, 255, 0.16), transparent 70%),
			radial-gradient(50ch 40ch at 85% 0%, rgba(52, 211, 153, 0.08), transparent 70%);
		pointer-events: none;
	}
	.hero .wrap {
		position: relative;
	}
	.hero h1 {
		margin-bottom: 1.25rem;
		max-width: 18ch;
	}
	.hero-form {
		margin-top: 2rem;
	}
	.secondary-cta {
		margin: 1rem 0 0;
		font-size: 0.9rem;
	}
	.offer {
		display: inline-block;
		margin: 2rem 0 0;
		padding: 0.6rem 1rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		background: rgba(52, 211, 153, 0.07);
		border: 1px solid rgba(52, 211, 153, 0.25);
		border-radius: 8px;
	}
	.offer strong {
		color: var(--signal);
	}

	/* Hero proof strip */
	.proof {
		list-style: none;
		margin: 2.75rem 0 0;
		padding: 2rem 0 0;
		border-top: 1px solid var(--border);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1.5rem 2rem;
	}
	.proof li {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.proof-stat {
		font-family: var(--font-mono);
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text);
		letter-spacing: -0.01em;
	}
	.proof-label {
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--text-dim);
	}

	/* Bands */
	.band {
		padding: 5rem 0;
		border-top: 1px solid var(--border);
	}
	.band.alt {
		background: var(--bg-elevated);
	}
	.band h2 {
		margin-bottom: 1.5rem;
	}
	.narrow {
		max-width: 68ch;
	}
	.narrow p {
		color: var(--text-muted);
	}

	/* How it works */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
		margin-top: 2.5rem;
	}
	.card {
		padding: 1.75rem;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.card .tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--signal);
		margin-bottom: 0.75rem;
	}
	.card h3 {
		margin-bottom: 0.6rem;
	}
	.card p:last-child {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	/* Coverage */
	.watch-block {
		margin-top: 2.75rem;
	}
	.watch-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0 0 0.25rem;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text);
	}
	.watch-head span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-dim);
	}
	.coverage-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin-top: 1.25rem;
	}
	.coverage-cell {
		padding: 1.25rem 1.4rem;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 0.15s ease;
	}
	.coverage-cell:hover {
		border-color: var(--border-bright);
	}
	.coverage-layer {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 0.9rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.coverage-tickers {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.coverage-tickers li {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text);
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.3rem 0.55rem;
	}
	.themes {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 0.75rem;
	}
	.themes li {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1rem 1.25rem;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		border-left: 2px solid var(--signal);
		border-radius: 8px;
	}
	.theme-name {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-bright);
	}
	.theme-blurb {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--text-muted);
	}
	.coverage-note {
		margin: 1.5rem 0 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--text-dim);
		max-width: 70ch;
	}

	/* Sample teaser */
	.teaser-card {
		margin-top: 2.5rem;
		background: var(--bg-panel);
		border: 1px solid var(--border-bright);
		border-radius: var(--radius);
		overflow: hidden;
	}
	.teaser-flag {
		margin: 0;
		padding: 0.7rem 1.5rem;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--text-dim);
		background: rgba(250, 204, 21, 0.06);
		border-bottom: 1px solid var(--border);
	}
	.teaser-entry {
		padding: 1.5rem;
	}
	.teaser-entry p {
		margin: 0 0 0.5rem;
	}
	.teaser-head {
		font-size: 0.98rem;
		color: var(--text);
	}
	.teaser-tags {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--accent);
	}
	.teaser-body {
		font-size: 0.92rem;
		color: var(--text-muted);
	}
	.teaser-foot {
		margin: 0 !important;
		font-size: 0.78rem;
		color: var(--text-dim);
	}
	.teaser-foot span {
		text-decoration: underline dotted;
	}

	/* Pricing */
	.pricing {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 3rem;
		align-items: start;
	}
	.pricing .lede {
		margin-bottom: 2rem;
	}
	.price-card {
		padding: 2rem;
		background: var(--bg-panel);
		border: 1px solid var(--border-bright);
		border-radius: var(--radius);
	}
	.plan {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}
	.trial-badge {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-bright);
		background: rgba(52, 211, 153, 0.12);
		border: 1px solid var(--border-bright);
		border-radius: 999px;
		padding: 0.25rem 0.7rem;
		margin-bottom: 0.75rem;
	}
	.amount {
		font-size: 2.75rem;
		font-weight: 700;
		color: #fff;
		line-height: 1;
		margin-bottom: 1.5rem;
	}
	.amount span {
		display: block;
		font-size: 0.85rem;
		font-weight: 400;
		color: var(--text-dim);
		margin-top: 0.5rem;
	}
	.price-card ul {
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.price-card li {
		padding: 0.5rem 0 0.5rem 1.5rem;
		position: relative;
		border-top: 1px solid var(--border);
	}
	.price-card li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 1.05rem;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--signal);
	}
	.offer-note {
		font-size: 0.8rem;
		color: var(--signal);
		margin-bottom: 1rem;
	}
	.secured {
		margin: 0;
		font-size: 0.78rem;
